#!/usr/bin/env bash
set -euo pipefail
ZERO_SHA=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO_SHA" ] && continue
  if [ "$(git cat-file -t "$local_sha")" = tag ]; then
    bash scripts/identity-guard.sh tag "$local_sha"
  fi
  # Scan all history reachable from the outgoing ref, including new branches/tags.
  bash scripts/identity-guard.sh commits "$local_sha"
  node scripts/publication-guard.mjs commits "$local_sha"
  bash scripts/secret-scan.sh commits "$local_sha"
done
