{
  "name": "chessblox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:dev": "vite build --mode development",
    "start": "node scripts/start-railway-service.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "launch:check": "node scripts/robinhood-launch-readiness.mjs",
    "launch:check:sponsored-program": "node scripts/sponsored-program-readiness-check.mjs",
    "supabase:functions:check": "deno check --config supabase/functions/pvp-referee/deno.json supabase/functions/pvp-referee/index.ts",
    "setup:anonymous-git": "bash scripts/setup-anonymous-git.sh",
    "identity:check": "bash scripts/identity-guard.sh config",
    "solana:escrow:test": "cargo test --manifest-path programs/game-escrow/Cargo.toml",
    "solana:mainnet:check": "bash scripts/solana-mainnet-check.sh",
    "solana:mainnet:build": "bash scripts/solana-mainnet-build.sh",
    "solana:mainnet:deploy-escrow": "node scripts/deploy-mainnet-escrow.mjs",
    "solana:mainnet:setup-escrow-config": "node scripts/setup-mainnet-escrow-config.mjs",
    "wager:setup-production-env": "node scripts/setup-production-wager-env.mjs",
    "wager:settlement-worker": "node scripts/wager-settlement-worker.mjs",
    "wager:robinhood:compile": "node scripts/compile-robinhood-escrow.mjs",
    "wager:robinhood:deploy": "npm run wager:robinhood:compile && node scripts/deploy-robinhood-escrow.mjs",
    "wager:robinhood:settlement-worker": "node scripts/robinhood-wager-settlement-worker.mjs",
    "wager:reclaim-contest-rent": "node scripts/wager-settlement-worker.mjs --reclaim-contest-rent",
    "wager:reconcile-sponsored-rent": "node scripts/wager-settlement-worker.mjs --reconcile-sponsored-rent",
    "test:sponsored-wagers": "vitest run src/test/pvpSponsoredWagerGuards.test.ts src/lib/wagerSettlement.test.ts src/test/pvpRefereeSessionSecurity.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "launch:check:solana": "node scripts/launch-readiness-check.mjs && npm run launch:check:sponsored-program",
    "wager:robinhood:auto:compile": "node scripts/compile-robinhood-auto-escrow.mjs",
    "setup:security": "bash scripts/setup-security.sh",
    "security:check": "node scripts/publication-guard.mjs staged && bash scripts/secret-scan.sh staged",
    "test:guards": "node --test scripts/publication-guard.test.mjs",
    "test:deploy": "node --test scripts/deployment-smoke.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@metamask/connect-solana": "2.1.0",
    "@noble/hashes": "1.8.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-three/drei": "^9.122.0",
    "@solana/spl-token": "0.4.14",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-coinbase": "0.1.23",
    "@solana/wallet-adapter-ledger": "0.9.29",
    "@solana/wallet-adapter-phantom": "0.9.29",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-react-ui": "0.9.39",
    "@solana/wallet-adapter-solflare": "0.6.33",
    "@solana/web3.js": "1.98.4",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.83.0",
    "buffer": "6.0.3",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "viem": "2.56.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@gltf-transform/core": "^4.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "ganache": "7.9.2",
    "jsdom": "^20.0.3",
    "solc": "0.8.30",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom"
  }
}
