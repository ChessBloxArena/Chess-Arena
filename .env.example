# Copy to .env.local for local development, or set these in your deploy host.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key

VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_ROBINHOOD_ESCROW_ADDRESS=

# Public launch-token display only. Leave blank until the official CA is announced.
VITE_LAUNCH_CONTRACT_ADDRESS=
VITE_LAUNCH_TOKEN_SYMBOL=

VITE_WAGER_NEW_WAGERS_ENABLED=false
VITE_WAGER_REAL_ESCROW_ENABLED=false
VITE_WAGER_PAYMENT_MODE=robinhood_eth_escrow
VITE_WAGER_GAME_ID=chess-arena
VITE_WAGER_RULES_HASH=chess-arena-v1
VITE_WAGER_CONTEST_TTL_SECONDS=86400

VITE_WAGER_PRESET_STAKES=0.002,0.004,0.01,0.025,0.03,0.035,0.04,0.14,0.24,0.34
VITE_WAGER_MAX_STAKE_UNITS=0.34

# pvp-referee / worker secrets. Never expose these with a VITE_ prefix.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_ESCROW_ADDRESS=
ROBINHOOD_RESULT_AUTHORITY=
ROBINHOOD_RESULT_SIGNER_PRIVATE_KEY=
PVP_ROBINHOOD_MAX_STAKE_WEI=340000000000000000
ROBINHOOD_MIN_CONFIRMATIONS=2
UNISWAP_API_KEY=
UNISWAP_RBLX_SLIPPAGE_BPS=100

VITE_ENABLE_DEV_WALLET=false

# Worker-only CPU reward payout settings. Do not expose private key material to the browser.
CPU_REWARDS_ENABLED=false
CPU_REWARD_TOKEN_MINT=Dp4pqN6R2WprUakMDdqjEdebFbNrdWRPJAeexpvYpump
CPU_REWARD_TOKEN_PROGRAM_ID=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
CPU_REWARD_TOKEN_DECIMALS=6
CPU_REWARD_WORKER_BATCH_SIZE=5
# CPU_REWARD_PAYER_KEYPAIR_JSON=<store only in Railway/Supabase worker secrets>

# Server-only settlement configuration. Never use VITE_ for secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PVP_REFEREE_SERVICE_TOKEN=
# Block containing the deployed escrow; used to recover mined settlements.
ROBINHOOD_ESCROW_DEPLOY_BLOCK=

# Enable only after the backend Uniswap key and wallet eligibility flow are verified.
VITE_RBLX_CONVERSION_ENABLED=false

# Automatic RBLX v2. Keep legacy address for all existing matches.
VITE_AUTOMATIC_RBLX_PAYOUT_ENABLED=false
VITE_ROBINHOOD_AUTO_ESCROW_ADDRESS=
PVP_AUTOMATIC_RBLX_PAYOUT_ENABLED=false
ROBINHOOD_AUTO_ESCROW_ADDRESS=
ROBINHOOD_AUTO_ESCROW_DEPLOY_BLOCK=
